# Discord Developer Portal > Your App > Bot > Reset Token if needed
DISCORD_TOKEN=put_your_bot_token_here

# Discord Developer Portal > General Information > Application ID
CLIENT_ID=put_your_application_id_here

# Optional: set this to your test server ID for instant command updates.
# Leave blank to register commands globally (global updates can take longer).
GUILD_ID=

# Railway PostgreSQL service reference variable: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://user:password@host:5432/database

# Usually leave false for Railway's private network connection.
# Set true only if your database endpoint requires TLS.
PGSSL=false

# Optional label used in bot startup logs
BOT_NAME=Joraba Invite Tracker
